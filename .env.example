# ===================================================================
# AuraPet - biến môi trường mẫu
# Sao chép thành ".env" rồi điền giá trị thật (.env KHÔNG được commit)
# ===================================================================

# ---- Bảo mật (BẮT BUỘC) ----
# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng: openssl rand -hex 32
# hoặc PowerShell: -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
AURAPET_JWT_SECRET=

# ---- Cơ sở dữ liệu: chọn 1 trong 2 ----
# (1) MariaDB/MySQL trên máy
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aurapetdb
DB_USER=root
DB_PASSWORD=
# (2) Supabase PostgreSQL: bỏ dấu # ở 4 dòng dưới
# SPRING_PROFILES_ACTIVE=supabase
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_DB_USER=postgres.your-project-ref
# SUPABASE_DB_PASSWORD=

# ---- MQTT: kết nối máy cho ăn ESP32 ----
# Khuyên dùng EMQX Serverless (miễn phí, có tài khoản): MQTT_PORT=8883, MQTT_TLS=true
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
# Chuỗi bí mật, PHẢI trùng TOPIC_PREFIX trong firmware/esp32_aurapet/secrets.h
MQTT_TOPIC_PREFIX=aurapet/doi-chuoi-ngau-nhien-o-day

# ---- Bác sĩ AI (tuỳ chọn) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Camera Raspberry Pi: khoá bí mật để Pi gửi ảnh trực tiếp (đặt cùng giá trị CAMERA_KEY khi chạy cat_detection_gateway.py)
CAMERA_KEY=

# ---- Khác ----
PORT=8080
# Tạo dữ liệu mẫu khi CSDL trống (tài khoản admin@aurapet.com / Admin@123)
AURAPET_DEMO_DATA=true
# Danh sách domain được gọi API, cách nhau dấu phẩy (để trống = cho phép tất cả)
CORS_ALLOWED_ORIGINS=
