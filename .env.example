# ========================================
# AuraPet Environment Variables
# Copy this file to .env and fill values
# ========================================

# Database Option 1: Supabase Cloud PostgreSQL (Khuyên dùng khi deploy)
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_DB_USER=postgres.your-project-ref
# SUPABASE_DB_PASSWORD=your-supabase-password
# SPRING_PROFILES_ACTIVE=supabase

# Database Option 2: MariaDB / MySQL cục bộ
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aurapetdb
DB_USER=root
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT Security (generate with: openssl rand -hex 32)
AURAPET_JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# Gemini AI (optional, for AI chat proxy)
GEMINI_API_KEY=

# Server
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# CORS (comma-separated domains, e.g. https://aurapet.com,https://api.aurapet.com)
CORS_ALLOWED_ORIGINS=
