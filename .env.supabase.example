# ===================================================================
# AuraPet Environment Variables (Supabase PostgreSQL Cloud)
# Đổi tên file thành .env khi sử dụng
# ===================================================================

# 1. Supabase PostgreSQL Connection
# Lấy tại Supabase Dashboard -> Project Settings -> Database -> Connection string (JDBC / Pooler)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-secure-supabase-password

# 2. JWT Secret Key (Khóa 256-bit bảo mật)
AURAPET_JWT_SECRET=d774dfc564fce6b2d9d56de4985e8152f0e3bb944f53c1f87bb15bc2d4a11ff2

# 3. Gemini AI API Key (Tùy chọn)
GEMINI_API_KEY=

# 4. Cấu hình Server
PORT=8080
SPRING_PROFILES_ACTIVE=supabase
CORS_ALLOWED_ORIGINS=https://*,http://localhost:*
